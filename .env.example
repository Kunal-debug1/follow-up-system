# Supabase: Project Settings -> Database -> Connection string (URI), with sslmode=require.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Required before a public deployment. Use long, unique values.
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=change-this-before-deployment
CRM_AUTH_SECRET=change-this-to-a-long-random-secret

# Comma-separated public frontend URLs.
CORS_ORIGINS=https://your-frontend.onrender.com
