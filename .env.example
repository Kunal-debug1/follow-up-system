# ---------------------------------------------------------------------------
# Backend Environment Variables (Render Web Service)
# ---------------------------------------------------------------------------

# Supabase PostgreSQL Connection String (must include ?sslmode=require)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Admin Authentication
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=change-this-to-a-secure-password
CRM_AUTH_SECRET=change-this-to-a-long-random-signing-secret

# Allowed CORS Origins (comma-separated frontend URLs)
CORS_ORIGINS=https://crm-follow-up-web.onrender.com,http://localhost:5173

# Optional Import Performance & Safety Tunables
IMPORT_BATCH_SIZE=250
MAX_UPLOAD_BYTES=12582912
MAX_WORKSHEET_ROWS=50000

# ---------------------------------------------------------------------------
# Frontend Environment Variables (Render Static Site)
# ---------------------------------------------------------------------------
VITE_API_URL=https://crm-follow-up-api.onrender.com

# ---------------------------------------------------------------------------
# Cron Keepalive Service (Render Cron Job)
# ---------------------------------------------------------------------------
BACKEND_HEALTH_URL=https://crm-follow-up-api.onrender.com/health
